# ==============================================================================
# VOTE-GUARD Backend Environment Configuration Template
# Instructions:
# 1. Copy this file and rename it to: .env
# 2. Update DB_PASSWORD with your actual MySQL root password.
# 3. Keep .env strictly local. Never commit .env or passwords to Git.
# ==============================================================================

# Application Settings
APP_NAME="VOTE-GUARD Verification API"
APP_VERSION="1.0.0"
APP_ENV="development"
HOST="0.0.0.0"
PORT=8000
DEBUG=True

# MySQL Database Settings (Configured for your existing vote_guard database)
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD="your_mysql_root_password_here"
DB_NAME="vote_guard"
DB_ECHO=False

# Security Secrets (Required for session & JWT token cryptographic signing)
# Generate a strong 256-bit random key (e.g. openssl rand -hex 32)
SECRET_KEY="generate-a-secure-random-secret-key-here"
JWT_SECRET_KEY="generate-a-secure-random-jwt-secret-key-here"
